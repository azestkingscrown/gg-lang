{
  "extends": "$app/tsconfig",
  "include": ["src", "*"],
  "exclude": [
    "src/service-worker",
    "src/lib/wasm-pkg",
    "src/__tests__",
    "editors",
    "crates",
    "target"
  ],
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  }
}
