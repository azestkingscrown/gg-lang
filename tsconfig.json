{
  "extends": "$app/tsconfig",
  "include": ["src", "*"],
  "exclude": [
    "src/service-worker",
    "src/cli.ts",
    "src/cli-format.ts",
    "src/repl.ts",
    "src/__tests__",
    "dist-pkg",
    "editors"
  ],
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  }
}
